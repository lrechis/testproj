<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+ draws edge-to-edge with transparent system bars; the layout's
         fitsSystemWindows adds the padding, and dark icons suit the light background. -->
    <style name="Theme.KittenTts" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
