# Google Maps Platform API key with the "Weather API" enabled.
# Create one at https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=

# Optional
PORT=3000
CACHE_TTL_SECONDS=600      # serve cached forecasts for this long before auto-refetching
MIN_REFRESH_SECONDS=60     # minimum gap between manual refreshes that hit the API
# WEATHER_MOCK=1           # run with bundled sample data (no key needed)
